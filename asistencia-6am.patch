+@override_settings(PISO_ASISTENCIA_DIARIA="06:00")
+class DailyCutoffTests(FloorBase):
+    """Corte diario de las 6:00: todos vuelven a confirmar la llegada, tengan o no una tarea asignada."""
+
+    def setUp(self):
+        super().setUp()
+        from django.core.cache import cache
+
+        cache.clear()
+        # gina: con tablet pero SIN ninguna tarea asignada
+        self.gina = Employee.objects.create(document="1003", full_name="gina lopez", shift=self.shift)
+        acc = FloorAccess(employee=self.gina)
+        acc.set_pin("1234")
+        acc.save()
+
+    def at(self, day_offset, h, m=0):
+        d = timezone.localdate() + timedelta(days=day_offset)
+        return datetime(d.year, d.month, d.day, h, m, tzinfo=timezone.get_current_timezone())
+
+    def test_yesterdays_confirmation_stops_counting_at_6am(self):
+        from . import checkin
+
+        checkin.confirm(self.ana, now=self.at(0, 22, 0))
+        self.assertTrue(checkin.confirmed(self.ana, self.at(1, 5, 30)))    # de madrugada sigue valiendo
+        self.assertFalse(checkin.confirmed(self.ana, self.at(1, 6, 0)))    # a las 6:00 hay que confirmar de nuevo
+        self.assertFalse(checkin.confirmed(self.ana, self.at(1, 9, 0)))
+
+    @override_settings(PISO_ASISTENCIA_DIARIA="")
+    def test_without_a_cutoff_it_only_expires_after_14_hours(self):
+        from . import checkin
+
+        checkin.confirm(self.ana, now=self.at(0, 22, 0))
+        self.assertTrue(checkin.confirmed(self.ana, self.at(1, 6, 0)))
+        self.assertTrue(checkin.confirmed(self.ana, self.at(1, 11, 59)))
+        self.assertFalse(checkin.confirmed(self.ana, self.at(1, 12, 1)))
+
+    def test_everyone_confirms_whether_or_not_they_have_a_task(self):
+        from . import checkin
+
+        for emp in (self.ana, self.gina):
+            checkin.confirm(emp, now=self.at(0, 22, 0))
+        self.assertTrue(floor.employee_tasks(self.ana))
+        self.assertFalse(floor.employee_tasks(self.gina))
+        now = self.at(1, 6, 0)
+        for emp in (self.ana, self.gina):
+            st = checkin.state(emp, now)
+            self.assertFalse(st["done"], emp.full_name)
+        self.assertEqual(checkin.state(self.ana, now)["info"]["operation"], "Armar")
+        self.assertEqual(checkin.state(self.gina, now)["info"]["operation"], "")
+
+    def test_person_without_task_is_blocked_until_confirming(self):
+        from mes_core.models import Attendance
+
+        self.login(doc="1003", checkin=False)
+        s = self.client.get(reverse("piso:api_state")).json()
+        self.assertFalse(s["checkin"]["done"])
+        self.assertEqual(s["checkin"]["info"]["operation"], "")
+        self.assertEqual(self.post("piso:api_mark", {"k": "p"}).status_code, 409)
+        self.assertTrue(self.post("piso:api_checkin").json()["state"]["checkin"]["done"])
+        self.assertTrue(Attendance.objects.filter(employee=self.gina, day=timezone.localdate()).exists())
+
+    def test_arriving_in_the_hour_before_the_cutoff_counts_for_the_new_day(self):
+        from . import checkin
+
+        checkin.confirm(self.ana, now=self.at(1, 5, 20))
+        checkin.confirm(self.beto, now=self.at(1, 4, 30))
+        now = self.at(1, 6, 30)
+        self.assertTrue(checkin.confirmed(self.ana, now))      # llegó a las 5:20: ya cuenta para hoy
+        self.assertFalse(checkin.confirmed(self.beto, now))    # 4:30 queda fuera de la última hora
+
+    def test_new_day_creates_a_new_attendance_record(self):
+        from mes_core.models import Attendance
+
+        from . import checkin
+
+        checkin.confirm(self.ana, now=self.at(0, 22, 0))
+        checkin.confirm(self.ana, now=self.at(1, 6, 10))
+        self.assertEqual(Attendance.objects.filter(employee=self.ana).count(), 2)
+        self.assertTrue(Attendance.objects.filter(employee=self.ana, day=self.at(1, 6, 10).date()).exists())
+
+    def test_cutoff_setting_with_garbage_is_ignored(self):
+        from . import checkin
+
+        for raw in ("", "no-es-hora", "25:99", "6"):
+            with override_settings(PISO_ASISTENCIA_DIARIA=raw):
