+def daily_cutoff(now=None) -> "datetime | None":
+    """Último corte diario de la asistencia (por defecto las 6:00, ``PISO_ASISTENCIA_DIARIA``; vacío o mal escrito =
+    sin corte). Es el más reciente que ya pasó: antes de las 6:00 es el de ayer."""
+    raw = str(getattr(settings, "PISO_ASISTENCIA_DIARIA", "06:00") or "").strip()
+    if not raw:
+        return None
+    local = timezone.localtime(now or timezone.now())
+    try:
+        hh, mm = (int(x) for x in raw.split(":")[:2])
+        cut = local.replace(hour=hh, minute=mm, second=0, microsecond=0)
+    except ValueError:
+        return None
+    return cut if cut <= local else cut - timedelta(days=1)
+
+
+def valid_since(now) -> datetime:
+    """Desde cuándo vale una llegada confirmada: las últimas 14 horas, sin pasar del corte diario (menos la hora de
+    anticipo). Una confirmación de antes de eso ya no cuenta y se pide de nuevo."""
+    since = now - VALID
+    cut = daily_cutoff(now)
+    return max(since, cut - EARLY) if cut is not None else since
+
+
 def confirmed(emp: Employee, now=None) -> bool:
-    """¿Ya confirmó su llegada en las últimas 14 horas? (memoria del servidor primero: lo consulta cada acción)."""
